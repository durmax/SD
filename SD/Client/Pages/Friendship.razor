@inherits FriendshipBase

<div class="row">
    <div class="col-8">
        <a type="button" class="btn btn-link"
           href="MyWords/@friendId/@friendName">@friendName</a>
    </div>
    <div class="col-4">

        @{
            switch (Relationship)
            {
                //case "NotImportant":

                //    break;

                case SD.Shared.Relation.Friend:

                    <button type="button" class="btn btn-link"
                            @onclick="@(async () => { await RemoveFriend(friendId); })">
                        <img width="20" height="20" src="/icons/user-minus-solid.svg" asp-append-version="true" />
                    </button>
                    break;

                case SD.Shared.Relation.FriendRequestTo:

                    <div class="btn btn-link">
                        <img width="20" height="20" src="/icons/paper-plane-solid.svg" asp-append-version="true" />
                    </div>
                    break;

                case SD.Shared.Relation.FriendRequestFrom:

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <button type="button" class="btn btn-link"
                                    @onclick="@(async () => { await AddFriend(); })">
                                <img width="20" height="20" src="/icons/user-check-solid.svg" asp-append-version="true" />
                            </button>

                            <button type="button" class="btn btn-link"
                                    @onclick="@(async () => { await RemoveFriendRequest(); })">
                                <img width="20" height="20" src="/icons/user-times-solid.svg" asp-append-version="true" />
                            </button>
                        </div>
                    </div>
                    break;

                default:

                    <button type="button" class="btn btn-link"
                            @onclick="@(async () => { await SendFriendRequest(friendId); })">
                        <img width="20" height="20" src="/icons/user-plus-solid.svg" asp-append-version="true" />
                    </button>
                    break;
            }
        }
    </div>
</div>