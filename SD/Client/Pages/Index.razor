@page "/"
@inherits IndexBase

@if (CurrUsrService.isAuthTested)
{
    @if (FriendRequestsDictionary.Count > 0)
    {
        <button type="button" class="btn btn-primary mb-2" @onclick="() => Collapsed = Collapsed ? false : true">
            Friend Requests <span class="badge badge-light">@FriendRequestsDictionary.Count</span>
            <span class="sr-only">Friend Requests</span>
        </button>

        <div class="card @(Collapsed ? "collapse" : "")">
            <div class="card-body">
                <div class="container">
                    @foreach (var item in FriendRequestsDictionary)
                    {
                        <Friendship UserId="@CurrUsrService.id" friendId="@item.Key" friendName="@item.Value" friendshipState="UserRequest"></Friendship>
                    }

                </div>
            </div>
        </div>
    }
}
    <Word Collapsed="false" OnWordSave="NewWordHandler"></Word>
    @if (Words != null)
    {
        @foreach (var word in Words)
        {
            <Word wordModel="word" OnWordDelete="DeleteWordHandler"></Word>
        }
    }
    @if (loading)
    {
        <button type="button" class="btn btn-light">
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </button>
    }
    else
    {
        @if (CurrUsrService.isAuthTested)
        {
            <button class="btn btn-outline-secondary bg-white text-dark m-2" type="button" @onclick="GetNextPage">
                Load more Words
            </button>
        }
    }