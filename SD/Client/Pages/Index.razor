@page "/"
@inherits IndexBase
@using Blazored.Typeahead


    <div class="container">
        <div class="row no-gutters">
            <div class="col-5">
                <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="SelectedFL">
                    <SelectedTemplate>
                        @context.Value
                    </SelectedTemplate>
                    <ResultTemplate>
                        @context.Value
                    </ResultTemplate>
                </BlazoredTypeahead>
            </div>

            <div class="col-auto">
                <button class="btn btn-primary" @onclick="Reverse"> <i class="fa fa-arrows-h" aria-hidden="true"></i>=></button>
            </div>
            <div class="col-5">
                <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="SelectedTL">
                    <SelectedTemplate>
                        @context.Value
                    </SelectedTemplate>
                    <ResultTemplate>
                        @context.Value
                    </ResultTemplate>
                </BlazoredTypeahead>
            </div>
        </div>
    </div>

    <br />

    <div class="input-group mb-3">
        <div class="input-group-prepend">
            <span class="input-group-text" id="basic-addon1">Search for word</span>
        </div>
        <input type="text" class="form-control" placeholder="Search for word"
               aria-label="Search for word" aria-describedby="basic-addon1"
               @bind-value="Word" />
    </div>

    <br />
    @if (SelectedFL != null && SelectedTL != null)
{
    <OtherPages FLangCode="@SelectedFL.Key" TLangCode="@SelectedTL.Key" Word="@Word" Collapsed="false"></OtherPages>
}
