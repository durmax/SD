@page "/"
@inherits IndexBase

<div class="input-group mb-3">
    <select class="custom-select" @bind="FLangCode">
        <option selected>Choose...</option>
        @foreach (var lang in langCodeService.Langs)
        {
            <option value="@lang.Key">@lang.Value</option>
        }
    </select>
    <div class="input-group-prepend">
        <button class="input-group-text" @onclick="Reverse"> <i class="fa fa-arrows-h" aria-hidden="true"></i></button>
    </div>
    <select class="custom-select" @bind="TLangCode">
        <option selected>Choose...</option>
        @foreach (var lang in langCodeService.Langs)
        {
            <option value="@lang.Key">@lang.Value</option>
        }
    </select>
</div>

<br />

<div class="input-group mb-3">
    <div class="input-group-prepend">
        <span class="input-group-text" id="basic-addon1">Search for word</span>
    </div>
    <input type="text" class="form-control" placeholder="Search for word"
           aria-label="Search for word" aria-describedby="basic-addon1"
           @bind-value="Word" />
</div>

<br />
<OtherPages FLangCode="@FLangCode" TLangCode="@TLangCode" Word="@Word" Collapsed="false"></OtherPages>