@page "/Languages"
@inherits LanguagesBase
@using Blazored.Typeahead


<div class="card">
    <div class="card-header"><b>@LanguageContainer.Keys["LangConfig"]</b></div>

    <div class="card-body">

        <div class="row pb-1">
            <div class="col-6"><lable>@LanguageContainer.Keys["Motherlanguage"]</lable></div>
            <div class="col-6">
                <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="SelectedTL">
                    <SelectedTemplate>
                        @context.Value
                    </SelectedTemplate>
                    <ResultTemplate>
                        @context.Value
                    </ResultTemplate>
                </BlazoredTypeahead>
            </div>
        </div>

        <div class="row pb-1">
            <div class="col-6"><lable>@LanguageContainer.Keys["Secondlanguage"]</lable></div>
            <div class="col-6">
                <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="SelectedFL">
                    <SelectedTemplate>
                        @context.Value
                    </SelectedTemplate>
                    <ResultTemplate>
                        @context.Value
                    </ResultTemplate>
                </BlazoredTypeahead>
            </div>
        </div>
    </div>
</div>
<div class="card mt-2">
    <div class="card-header"><b>@LanguageContainer.Keys["LList"]</b></div>

    <div class="card-body">
        <div class="row pb-1">
            <div class="col-6">
                <label>
                    @LanguageContainer.Keys["AddLang"]
                </label>
            </div>
            <div class="col-6">
                <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="LangToAdd">
                    <SelectedTemplate>
                        @context.Value
                    </SelectedTemplate>
                    <ResultTemplate>
                        @context.Value
                    </ResultTemplate>
                </BlazoredTypeahead>
            </div>
        </div>


        @if (KnownLangs != null)
        {

            <div class="list-group">

                @foreach (var item in KnownLangs)
                {
                    <div @key="item"
                         class="list-group-item">
                        <label class="form-check-label">
                            @item
                        </label>
                        <button type="button" class="btn btn-link"
                                @onclick="(() => RemoveKnownLang(item))">
                            <i class="oi oi-delete"></i>
                        </button>

                    </div>
                }
            </div>
        }

    </div>
</div>
@if (KnownLangs != null)
{
    <div class="card mt-2 mb-2">
        <div class="input-group">
            <select class="bg-transparent rounded-0 border-0" @bind="Fl">
                @foreach (var item in KnownLangs)
                {
                    if (item == SelectedFL?.Key)
                    {
                        <option selected value="@SelectedFL?.Key">@item</option>
                    }
                    else
                    {
                        <option value="@item">@item</option>
                    }
                }
            </select>
            <button type="button" class="btn btn-light bg-transparent" @onclick="Reverse">
                <i class="oi oi-loop"></i>
            </button>
            <select class="bg-transparent rounded-0 border-0" @bind="Tl">
                @foreach (var item in KnownLangs)
                {
                    if (item == SelectedTL?.Key)
                    {
                        <option selected value="@SelectedTL?.Key">@item</option>
                    }
                    else
                    {
                        <option value="@item">@item</option>
                    }
                }
            </select>
        </div>

        <OtherPages FLangCode="@Fl" TLangCode="@Tl" Collapsed="false" CanSetFavSite="true"></OtherPages>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="mb-2">
                <button type="reset" class="btn btn-light" @onclick="ResetOPAsync"> Reset for @Fl-@Tl </button>
                <button type="reset" class="btn btn-danger float-right" @onclick="async ()=> await LocalStorageService.ClearAsync()">Remove all stored data</button>
            </div>
        </Authorized>
    </AuthorizeView>
}