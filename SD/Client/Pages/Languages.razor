@page "/Languages"
@inherits LanguagesBase
@using Blazored.Typeahead


    <div class="card">
        <div class="card-header"><b>@languageContainer.Keys["LangConfig"]</b></div>

        <div class="card-body">
            
            <div class="row pb-1">
                <div class="col-4"><lable>@languageContainer.Keys["Motherlanguage"]</lable></div>
                <div class="col-8">
                    <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="SelectedTL">
                        <SelectedTemplate>
                            @context.Value
                        </SelectedTemplate>
                        <ResultTemplate>
                            @context.Value
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
            </div>

            <div class="row pb-1">
                <div class="col-4"><lable>@languageContainer.Keys["Secondlanguage"]</lable></div>
                <div class="col-8">
                    <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="SelectedFL">
                        <SelectedTemplate>
                            @context.Value
                        </SelectedTemplate>
                        <ResultTemplate>
                            @context.Value
                        </ResultTemplate>
                    </BlazoredTypeahead>
                </div>
            </div>
        </div>
    </div>
<div class=card>
    <div class="card-header"><b>@languageContainer.Keys["LList"]</b></div>

    <div class="card-body">
        <div class="row pb-1">
            <div class="col-4">
                <label>
                    @languageContainer.Keys["AddLang"]
                </label>
            </div>
            <div class="col-8">
                <BlazoredTypeahead SearchMethod="SearchLangs" @bind-Value="LangToAdd">
                    <SelectedTemplate>
                        @context.Value
                    </SelectedTemplate>
                    <ResultTemplate>
                        @context.Value
                    </ResultTemplate>
                </BlazoredTypeahead>
            </div>
        </div>

        <div class="row pb-2">

            @if (KnownLangs != null)
            {

                <ul class="list-group">

                    @foreach (var item in KnownLangs)
                    {
                        <li @key="item"
                            class="list-group-item">
                            <label class="form-check-label">
                                @item
                            </label>
                            <button type="button" class="btn btn-link"
                                    @onclick="(() => RemoveKnownLang(item))">
                                <i class="fas fa-backspace"></i>
                            </button>
                        </li>
                    }
                </ul>

            }
        </div>
    </div>
</div>
