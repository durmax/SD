@inherits LikeBase


<button type="button" style="float:left" class="btn btn-light bg-transparent">
    <img width="20" height="20" src="@CULikeImg" asp-append-version="true" @onclick="async () => { await Like(); }" />
    @LikesCount
</button>

@if (LikesCount != null && (CULiked? LikesCount > 1: LikesCount > 0))
{
    <button type="button" class="btn btn-light bg-transparent" @onclick="async() => { Collapsed = (Collapsed) ? false : true; await GetLikedUsers(LikesCount); }">
        <i class="@(Collapsed ? "oi oi-caret-bottom" : "oi oi-caret-top") pt-1 pl-1"></i>
    </button>
}
<div class=@(Collapsed? "collapse" : "")>
    @if (likedUsers != null)
    {
        @foreach (var foudUser in likedUsers)
        {
            <Friendship UserId="@CurrentUserId" friendId="@foudUser.Key" friendName="@foudUser.Value.Item1" friendshipState="NotImportant"></Friendship>
        }
    }
</div>
