@page "/MyWords"
@page "/MyWords/{UserId}/{UserName}"
@inject ILanguageContainerService languageContainer
@inherits MyWordsBase

<h3>@UserName</h3>

<div class="sticky-top pb-1">
    <Word UserId="@UserId" OnWordSave="NewWordHandler" Collapsed="Collapsed"></Word>
</div>

@foreach (var word in Words)
{
    <Word wordModel="word" OnWordDelete="DeleteWordHandler"></Word>
}

<button class="btn btn-outline-secondary bg-white text-dark m-2 @( loading ? "d-none": null)" type="button" @onclick="GetNextPage">
    Load more Words
</button>

@if (loading)
{
    <button type="button" class="btn btn-light">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </button>
}



