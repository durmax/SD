@page "/MyWords"
@page "/MyWords/{UserId}/{UserName}"
@inherits MyWordsBase

<h3>@UserName</h3>

@if (Words == null)
{
    <div style="position:absolute; top:30vh; text-align:center">
        <p><i class="fas fa-spin fa-spinner"></i> The WORDS are loading...</p>
    </div>
}
else
{
<div class="sticky-top pb-1">
    <Word wordModel="@wordModel" UserId="@UserId"  OnWordSave="NewWordHandler"></Word>
    @if (loading)
    {
        <div class="d-flex justify-content-center p-1">
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    }
</div>

    <div class="ml-5 mr-4">
        <ol class="list-group">
            @foreach (var word in Words)
            {
                <li>
                    <div class="list-group-item p-1 ">
                        <div class="input-group" role="group">
                            <button type="button" class="btn btn-light" @onclick="() => { wordModel = word; }">
                                <b style="@styleDeleted"> @word.Title </b>
                            </button>

                            <button type="button" class="btn btn-light @cssClassDelete " @onclick="async () => { wordModel = word; await DeleteWord(); }">
                                <i class="fas fa-trash-alt"></i>
                            </button>

                            <button type="button" class="btn btn-light" @onclick="async () => { wordModel = word; await Like(); }">
                                <i class="fas fa-thumbs-up"></i>  @word.Likes?.Count
                            </button>
                        </div>
                    </div>
                </li>
            }
        </ol>
    </div>
}
