@page "/MyWords"
@page "/MyWords/{UserId}/{UserName}"
@inject ILanguageContainerService languageContainer
@inherits MyWordsBase

<h3>@UserName</h3>

<div class="sticky-top pb-1">
    <Word UserId="@CurrUsrService.id" OnWordSave="NewWordHandler" Collapsed="Collapsed"></Word>
</div>
@if (Words != null)
{
    @foreach (var word in Words)
    {   
        <Word wordModel="word" OnWordDelete="DeleteWordHandler"></Word>
    }
}
@if (loading)
{
    <button type="button" class="btn btn-light">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </button>
}
else
{
    <button class="btn btn-outline-secondary bg-white text-dark m-2" type="button" @onclick="GetNextPage">
        Load more Words
    </button>
}

