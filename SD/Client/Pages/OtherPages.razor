@inherits OtherPagesBase

@if (!Collapsed && opRes == null)
{
    <div class="d-flex justify-content-center p-1">
        <div class="spinner-border" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="card m-0 border-left-0 border-right-0">
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Dict";   Collapsed = false;   await GetOpRes(); })">
                <i class="fas fa-book"></i>
            </button>
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Trans";  Collapsed = false; await GetOpRes();})">
                <img src="/icons/translate-black-24dp.svg" asp-append-version="true" />
            </button>
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Vocab";  Collapsed = false; await GetOpRes();})">
                <img src="/icons/abc.svg" asp-append-version="true" width="24" height="24" />
            </button>
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Search"; Collapsed = false; await GetOpRes();})">
                <img src="/icons/image_search-24px.svg" asp-append-version="true" />
            </button>

            <div class="input-group-append">
                <button type="button" class="btn btn-light" @onclick="GetP">
                    <i class="float-right @(Collapsed? "oi oi-collapse-down" : "oi oi-collapse-up")"></i>
                </button>
            </div>
        </div>

        <div class=@(Collapsed? "collapse" : "")>

            <div class="card-body p-0">

                @if (opRes != null)
                {
                    <div class="list-group">
                        @foreach (var otherPage in opRes)
                        {
                            @if (otherPage.Type == opFilterVal)
                            {
                                <a href="@otherPage.Link" class="list-group-item pt-2 pb-2" onclick='window.open("@otherPage.Link","popup","width=900,height=600");return false;'>
                                    <u>@otherPage.Host</u>
                                </a>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>

}
