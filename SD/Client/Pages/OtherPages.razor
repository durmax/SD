@inherits OtherPagesBase
@inject ILanguageContainerService languageContainer

@if (!Collapsed && opRes == null)
{
    <div class="d-flex justify-content-center p-1">
        <div class="spinner-border" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="card m-0 border-left-0 border-right-0 overflow-auto" style="max-height:@MaxHeight">

        <div class="@(Collapsed? "collapse" : "")">

            <div class="card-body p-0 d-flex flex-column" dropzone="move" ondragover="event.preventDefault();" @ondrop="Drop">

                @if (opRes != null)
                {
@*                     @foreach (var otherPage in opRes)
                    {
                        <div class="d-flex">
                            <div class="flex-grow-1 pl-1 pt-1" onclick='window.open("@otherPage.Link","popup","width=900,height=600");return false;'>
                                <a href="@otherPage.Link">
                                    <u>@otherPage.Host</u>
                                </a>
                            </div>
                            <div class="float-right m-0">
                                @if (!string.IsNullOrWhiteSpace(FavSite) && FavSite.Contains(otherPage.Host))
                                {
                                    <button class="btn btn-light bg-transparent" @onclick="@(async () => { await Favorite(otherPage); })"><img width="20" height="20" src="/icons/crown-solid.svg" asp-append-version="true" /></button>
                                }
                                else
                                {
                                    if (CanSetFavSite || string.IsNullOrWhiteSpace(FavSite))
                                    {
                                        <button class="btn btn-light bg-transparent" @onclick="@(async () => { await Favorite(otherPage); })"><img width="20" height="20" src="/icons/crown-solid.svg" asp-append-version="true" style="opacity: 0.3;" /></button>
                                    }
                                }
                                <button class="btn btn-light bg-transparent" @onclick="@(async ()=> { await OtherPagesSort(otherPage.Host); })">
                                    <i class="float-right oi oi-arrow-top"></i>
                                </button>
                            </div>
                        </div>
                        <hr class="m-0">
                    } *@

                    @foreach (var otherPage in opRes)
                    {
                        <OtherPage otherPage=@otherPage FavSite="@FavSite" CanSetFavSite="@CanSetFavSite" FLangCode="@FLangCode" TLangCode="@TLangCode" OnDragStart="HandleDragStart" />
                    }
                    
                    @if (!string.IsNullOrWhiteSpace(Info))
                    {
                        <a class="btn-light float-right" href="@Info"> to set favorite site go to @languageContainer.Keys["LangConfig"] </a>
                    }
                }
            </div>
        </div>
    </div>

}
