
@inherits OtherPagesBase

@if (!Collapsed  && opRes == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="card m-0">
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Dict";   Collapsed = false;   await GetOpRes(); })"><i class="fas fa-book"></i></button>
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Trans";  Collapsed = false; await GetOpRes();})"><i class="oi oi-document"></i></button>
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Vocab";  Collapsed = false; await GetOpRes();})"><i class="fab fa-wikipedia-w"></i></button>
            <button type="button" class="btn btn-light" @onclick="@(async() => {opFilterVal = "Search"; Collapsed = false; await GetOpRes();})"><i class="fas fa-globe"></i></button>
            <div class="input-group-append">
                <button type="button" class="btn btn-light" @onclick="GetP">
                    <i class="float-right @(Collapsed? "oi oi-collapse-down" : "oi oi-collapse-up")"></i>
                </button>
            </div>
        </div>

        <div class=@(Collapsed? "collapse" : "")>

            <div class="card-body">

                @if (opRes != null)
                {
                    <div class="list-group pb-2">
                        @foreach (var otherPage in opRes)
                        {
                            @if (otherPage.Type == opFilterVal)
                            {
                                <a href="@otherPage.Link" target="popup" class="list-group-item list-group-item-action" onclick='window.open("@otherPage.Link","popup","width=900,height=600");return false;'>
                                    @otherPage.Host
                                </a>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>

}
