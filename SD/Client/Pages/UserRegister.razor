@page  "/User"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILanguageContainerService languageContainer

@inherits UserRegisterBase

<div class="alert alert-primary @InfoDisplayClass" role="alert">
    @Info
</div>

<AuthorizeView>
    <Authorized>
        <div class="card p-0">
            @*<EditForm Model="@userModel" OnValidSubmit="UserData">
                <DataAnnotationsValidator />
                <ValidationSummary />*@

            <div class="card-header">
                <p>@languageContainer.Keys["MyProfile"]</p>
            </div>
            <div class="card-body">

                <div class="col-sm-10">
                    <input class="form-control" placeholder="Nick Name"
                           @bind="userModel.Name" />
                </div>

                <div class="col-sm-10">
                    <p class="form-control"> @userModel.Email </p>
                </div>
            </div>
            <div class="card-footer">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-outline-primary" @onclick="SaveUserData"><i class="fa fa-save"></i> @languageContainer.Keys["Save"]</button>
                </div>
            </div>

            @* <div class="card-header"> <a href="Friends"> @languageContainer.Keys["YouHave"] <span class="badge badge-primary">@FriendsCount</span> @languageContainer.Keys["Friends"]</a></div>*@

        </div>
    </Authorized>
</AuthorizeView>