@page "/User"

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

@inherits UserRegisterBase


<h3>RegisterAccount</h3>

<AuthorizeView>
    <NotAuthorized>
        <a href="SignIn">
            <span class="oi oi-account-login" aria-hidden="true"></span> SignIn
        </a>
        <RedirectToLogin />
    </NotAuthorized>
    <Authorized Context="Auth">

        <EditForm Model="@userModel" OnValidSubmit="UserData">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group row">
                <div class="col-sm-10">
                    <InputText class="form-control" placeholder="Email"
                               @bind-Value="userModel.Email" />
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-10">
                    <InputText class="form-control" placeholder="Name"
                               @bind-Value="userModel.Name" />
                </div>
            </div>
            <Languages></Languages>
            <div class="form-group row">
                <div class="col-sm-10">
                    <input type="text" class="form-control" placeholder="Find friend"
                           @onchange="@(async(e)=> {await SearchUser((string)e.Value);})" />
                </div>
            </div>
            <div class="@SearchDisplayClass">
                @if (users == null)
                {
                    <b>Loading...</b>
                }
                else
                {

                    @foreach (var foudUser in users)
                    {
                        <a>@foudUser.Name</a> <button @onclick="@(async()=> { await SendFriendRequest(foudUser.UserId);})">Send Friend Request</button>
                    }
                }
            </div>

            <div class="form-group row">
                <div class="col-sm-10">
                    <div class="alert alert-primary @InfoDisplayClass" role="alert">
                        @Info
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-outline-primary"><i class="fa fa-save"></i> Save</button>
                </div>

            </div>
        </EditForm>

        <div class="col-sm-10">
            <button class="btn btn-outline-danger" @onclick="RemoveUser"><i class="fa fa-trash-o fa-lg"></i> Remove</button>
        </div>

    </Authorized>
</AuthorizeView>
