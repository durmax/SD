@page "/User"
@inherits UserRegisterBase
@using Blazored.Typeahead

<h3>RegisterAccount</h3>

<EditForm Model="@userModel" OnValidSubmit="UserData">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group row">
        <div class="col-sm-10">
            <InputText id="email" class="form-control" placeholder="Email"
                       @bind-Value="userModel.Email" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10">
            <div class="alert alert-primary @InfoShowClass" role="alert">
                @Info
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-outline-primary"><i class="fa fa-save"></i> Save</button>
        </div>

    </div>
</EditForm>

<div class="col-sm-10">
    <button class="btn btn-outline-danger" @onclick="RemoveUser"><i class="fa fa-trash-o fa-lg"></i> Remove</button>
</div>
