
@inherits WordBase

<div class="card">
    <a class="card-header" @onclick="() => Collapsed = (Collapsed) ? false : true ">
        <span>@word.WordLang:</span>
        <b style="@styleDeleted">@word.Title</b>
        
        <span class="float-right  @(Collapsed ? "oi oi-collapse-down" : "oi oi-collapse-up")"></span>
    </a>
    <div class=@(Collapsed ? "collapse" : "")>
        <button type="button" class="btn btn-light @cssClassDelete " @onclick="DeleteWord">
            <i class="fas fa-trash-alt"></i>
        </button>
        

        <div class="card-body">

            <div class="form-group">
                <label for="exampleFormControlTextarea1">the explaine...</label>
                <textarea class="form-control"> @word.Explain</textarea>
            </div>

            <OtherPages FLangCode="@word.WordLang" TLangCode="@word.ToLang" Word="@word.Title"></OtherPages>
        </div>
    </div>
</div>

