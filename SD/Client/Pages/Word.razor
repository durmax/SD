@inject ILanguageContainerService languageContainer
@inherits WordBase

<div class="card border-dark">

    <div class="text-muted pl-1">
        <i class="bg-light">@note</i>
    </div>
    <div class="input-group">
        @if (KnownLangs != null)
        {
            <select class="bg-transparent rounded-0 border-0" @bind="@wordDto.WordLang">
                @foreach (var item in KnownLangs)
                {
                    if (item == wordDto.WordLang)
                    {
                        <option selected value="@item">@item</option>
                    }
                    else
                    {
                        <option value="@item">@item</option>
                    }
                }
            </select>
        }

        <input type="search" class="form-control font-weight-bold" placeholder=@languageContainer.Keys["NewWord"]
               id="wordId"
               value="@wordDto.Title"
               @onkeyup="KeyupAsync"
               @onchange="@(async (ui) => { WordChanged((string)ui.Value); })"
               @oninput="@(()=>{ note = ""; cssClassUpdate = "d-none";})"
               @onclick="@(() => {if (Collapsed) OnCollapsed();})" />
    </div>

    <div class=@(Collapsed ? "collapse" : "")>
        <div class="btn-group" role="group">

            @if (KnownLangs != null)
            {
                <button type="button" class="btn btn-light bg-transparent" @onclick="Reverse">
                    <i class="fas fa-exchange-alt"></i>
                </button>

                <select class="bg-transparent rounded-0 border-0" @bind="@wordDto.ToLang">
                    @foreach (var item in KnownLangs)
                    {
                        if (item == wordDto.ToLang)
                        {
                            <option selected value="@item">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            }

            <button type="button" class="btn btn-light bg-transparent" @onclick="()=> {cssClassComment = !cssClassComment; SetMyText(); }">
                <img width="20" height="20" src="/icons/comment-dots-solid.svg" asp-append-version="true" />
            </button>
            <button @onclick="@(()=>{ShareWithCollapsed=!ShareWithCollapsed;})" class="btn btn-light  bg-transparent dropdown-toggle" type="button">
                <img width="20" height="20" src="@ShareWithClass" asp-append-version="true" />  <lable class="pl-1">@languageContainer.Keys["Save"]</lable>
            </button>


        </div>
        <button type="button" style="float:right" class="@cssClassDelete btn btn-light bg-transparent" @onclick="async () => { await DeleteWord(); }">
            <img width="20" height="20" src="/icons/trash-alt-solid.svg" asp-append-version="true" />
        </button>

        @if (loading)
        {
            <button type="button" class="btn btn-light bg-transparent">
                <div class="spinner-border spinner-border-sm" role="status">
                    <span class="sr-only">Loading...</span>
                </div>
            </button>
        }
        <div class="btn-group @(ShareWithCollapsed ? "collapse" : "")">
            <button class="btn btn-light bg-transparent" @onclick="@(async() => {ShareWithCollapsed = true; wordDto.ShareWith = 0; ShareWithClass = "/icons/user-lock-solid.svg"; await AddWord();})">@languageContainer.Keys["OnlyMe"] <img width="20" height="20" src="/icons/user-lock-solid.svg" asp-append-version="true" /></button>
            <button class="btn btn-light bg-transparent" @onclick="@(async() => {ShareWithCollapsed = true; wordDto.ShareWith = 1; ShareWithClass = "/icons/user-friends-solid.svg";  await AddWord();})">@languageContainer.Keys["Friends"] <img width="20" height="20" src="/icons/user-friends-solid.svg" asp-append-version="true" /></button>
            <button class="btn btn-light bg-transparent" @onclick="@(async() => {ShareWithCollapsed = true; wordDto.ShareWith = 2; ShareWithClass = "/icons/globe-solid.svg"; await AddWord();})">@languageContainer.Keys["Public"] <img width="20" height="20" src="/icons/globe-solid.svg" asp-append-version="true" /></button>
        </div>

    </div>

    <div class=@(Collapsed ? "collapse" : "")>
        <div class="card-body p-0">

            <div class="card mb-1 @cssClassUpdate">
                <div class="card-body">
                    <div class="text-muted">@wordDto.Title is already exist</div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="UpdateWord">
                        Update <i class="fas fa-question-circle"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="@(()=> {foundWordIdToUpdate=""; cssClassUpdate = "d-none";})">
                        Cancel <i class="fas fa-window-close"></i>
                    </button>
                </div>
            </div>

            <div class=" @(cssClassComment? "collapse" : "")">
                <div class="m-0">
                    <textarea class="form-control text-wrap"
                              rows="@Rows"
                              @bind-value="@MyText"
                              @bind-value:event="oninput">@MyText</textarea>
                </div>
            </div>

            @if (!(string.IsNullOrWhiteSpace(wordDto.WordLang) || string.IsNullOrWhiteSpace(wordDto.ToLang)))
            {
                <OtherPages FLangCode="@wordDto.WordLang" TLangCode="@wordDto.ToLang" Word="@wordDto.Title" Collapsed="@Collapsed"></OtherPages>
            }
        </div>
    </div>

    @if (wordDto != null)
    {
        <div class="card-footer p-0">
            <div class="row  fs-6">
                <div class="col-5">
                    <button type="button" style="float:left" class="btn btn-light bg-transparent" @onclick="async () => { await Like(); }">
                        <img width="20" height="20" src=@(CULiked ? "/icons/thumbs-up-solid.svg" : "/icons/thumbs-up-regular.svg") asp-append-version="true" />

                    </button>

                    @if (LikesCount != null && (CULiked ? LikesCount > 1 : LikesCount > 0))
                    {
                        <button type="button" class="btn btn-light bg-transparent" @onclick="async () => { await GetLikedUsers(LikesCount); }">
                            @LikesCount <i>likes</i>
                        </button>
                    }
                </div>

                <div type="button" style="float:right" class="col-2 btn btn-light bg-transparent" @onclick="OnCollapsed">
                    @if (!Collapsed)
                    {
                        <i class="oi oi-collapse-up"></i>
                    }
                </div>

                <div class="col-5">
                    <button type="button" style="float:right" class="btn btn-light bg-transparent" @onclick="GetWordCommentsAsync">
                        @if (wordDto.CommentsCount > 0)
                        {@wordDto.CommentsCount}

                        <img width="20" height="20" src="/icons/comment-dots-solid.svg" asp-append-version="true" />
                    </button>
                </div>
            </div>
        </div>
        <div class=@(CollapsedLike ? "collapse" : "")>
            @if (likedUsers != null)
            {
                @foreach (var foudUser in likedUsers)
                {
                    <Friendship UserId="@CurrentUser.id" friendId="@foudUser.UserId" friendName="@foudUser.RelationalUserName" Relationship="foudUser.Relation"></Friendship>
                }
            }
        </div>
        <div class="card m-0 border-left-0 border-right-0 @(CollapsedComm ? "collapse" : "")">
            @if (!CollapsedComm)
            {
                <CascadingValue Value="@CurrentUser.id">
                    <div class="card-body p-0">

                        @foreach (var comment in wordComments)
                        {
                            <Comment commentModel="@comment" WordId="@wordDto.WordId" CurrentUserName="@CurrentUser.name" WordUserId="@wordDto.UserId" OnCommentDelete="RemoveCommentHandlerAsync"></Comment>
                        }

                        <button type="button" class="btn btn-link bg-transparent" @onclick="@CreateComment">
                            <span>Add Comment </span> <img style="margin-left:5px;" width="20" height="20" src="/icons/comment-medical-solid.svg" asp-append-version="true" />
                        </button>
                    </div>
                </CascadingValue>
            }
        </div>
    }
</div>