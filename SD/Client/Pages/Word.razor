@inject ILanguageContainerService languageContainer
@inherits WordBase

<div class="card border-dark">

    <div class="text-muted pl-1">
        <i class="bg-light">@note</i>
    </div>
    <div class="input-group">

        @*<div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary bg-white text-dark" @onclick="NewWordAsync">
                    <i class="fas fa-plus"></i>
                </button>
            </div>*@

        <input type="search" class="form-control font-weight-bold" placeholder=@languageContainer.Keys["NewWord"]
               id="wordId"
               value="@wordModel.Title"
               @onchange="@(async (ui) => { WordChanged((string)ui.Value); })"
               @oninput="@(()=>{ note = ""; cssClassUpdate = "d-none";})" />

        <div class="input-group-append">
            <button class="btn btn-outline-secondary bg-white text-dark" type="button" @onclick="() => Collapsed = (Collapsed) ? false : true ">
                <i class="float-right @(Collapsed ? "oi oi-collapse-down" : "oi oi-collapse-up")"></i>
            </button>
        </div>

    </div>

    <div class=@(Collapsed ? "collapse" : "")>
        <div class="btn-group" role="group">

            @if (KnownLangs != null)
            {
                <select class="bg-transparent rounded-0 border-0" @bind="@wordModel.WordLang">
                    @foreach (var item in KnownLangs)
                    {
                        if (item == wordModel.WordLang)
                        {
                            <option selected value="@item">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>

                <button type="button" class="btn btn-light bg-transparent" @onclick="Reverse">
                    <i class="fas fa-exchange-alt"></i>
                </button>

                <select class="bg-transparent rounded-0 border-0" @bind="@wordModel.ToLang">
                    @foreach (var item in KnownLangs)
                    {
                        if (item == wordModel.ToLang)
                        {
                            <option selected value="@item">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            }

            <button type="button" class="btn btn-light bg-transparent" @onclick="()=> cssClassComment = cssClassComment ? false : true">
                <img width="20" height="20" src="/icons/comment-dots-solid.svg" asp-append-version="true" />
            </button>
            <button @onclick="@(()=>{ShareWithCollapsed=!ShareWithCollapsed;})" class="btn btn-light  bg-transparent dropdown-toggle" type="button">
                <img width="20" height="20" src="@ShareWithClass" asp-append-version="true" />  <lable class="pl-1">@languageContainer.Keys["Save"]</lable>
            </button>

            @if (loading)
            {
                <button type="button" class="btn btn-light bg-transparent">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </button>
            }
        </div>

        <div class="btn-group @(ShareWithCollapsed ? "collapse" : "")">
            <button class="btn btn-light bg-transparent" @onclick="@(async() => {ShareWithCollapsed = true; wordModel.ShareWith = 0; ShareWithClass = "/icons/user-lock-solid.svg"; await AddWord();})">@languageContainer.Keys["OnlyMe"] <img width="20" height="20" src="/icons/user-lock-solid.svg" asp-append-version="true" /></button>
            <button class="btn btn-light bg-transparent" @onclick="@(async() => {ShareWithCollapsed = true; wordModel.ShareWith = 1; ShareWithClass = "/icons/user-friends-solid.svg";  await AddWord();})">@languageContainer.Keys["Friends"] <img width="20" height="20" src="/icons/user-friends-solid.svg" asp-append-version="true" /></button>
            <button class="btn btn-light bg-transparent" @onclick="@(async() => {ShareWithCollapsed = true; wordModel.ShareWith = 2; ShareWithClass = "/icons/globe-solid.svg"; await AddWord();})">@languageContainer.Keys["Public"] <img width="20" height="20" src="/icons/globe-solid.svg" asp-append-version="true" /></button>
        </div>

    </div>

    <div class=@(Collapsed ? "collapse" : "")>
        <div class="card-body p-0">

            <div class="card mb-1 @cssClassUpdate">
                <div class="card-body">
                    <div class="text-muted">@wordModel.Title is already exist</div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="UpdateWord">
                        Update <i class="fas fa-question-circle"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="@(()=> {foundWordIdToUpdate=""; cssClassUpdate = "d-none";})">
                        Cancel <i class="fas fa-window-close"></i>
                    </button>
                </div>
            </div>

            <div class="form-group @(cssClassComment? "collapse" : "")">
                <div class="m-0">
                    <textarea class="form-control text-wrap"
                              rows="@Rows"
                              @bind-value="@MyText"
                              @bind-value:event="oninput">@MyText</textarea>
                </div>
            </div>

            @if (!(string.IsNullOrWhiteSpace(wordModel.WordLang) || string.IsNullOrWhiteSpace(wordModel.ToLang)))
            {
                <OtherPages FLangCode="@wordModel.WordLang" TLangCode="@wordModel.ToLang" Word="@wordModel.Title" Collapsed="@opCollapsed"></OtherPages>
            }
        </div>
    </div>
    <div class="card-footer p-0">
        <div class="row">
            <div class="col-4">
                <button type="button" style="float:left" class="btn btn-light bg-transparent">
                    <img width="20" height="20" src=@(CULiked? "/icons/thumbs-up-solid.svg" : "/icons/thumbs-up-regular.svg") asp-append-version="true"
                         @onclick="async () => { await Like(); }" />
                    @LikesCount
                </button>

                @if (LikesCount != null && (CULiked ? LikesCount > 1 : LikesCount > 0))
                {
                    <button type="button" class="btn btn-light bg-transparent" @onclick="async() => { CollapsedLike = (CollapsedLike) ? false : true; await GetLikedUsers(LikesCount); }">
                        <i class="@(CollapsedLike ? "oi oi-caret-bottom" : "oi oi-caret-top") pt-1 pl-1"></i>
                    </button>
                }
            </div>

            <div class="col-4">
                <button type="button" class="btn btn-light bg-transparent" @onclick="() => {CollapsedComm = CollapsedComm ? false : true; }">
                    <img width="20" height="20" src="/icons/comment-dots-solid.svg" asp-append-version="true" />
                    @wordComments.Count
                </button>
            </div>

            <div class="col-4 @cssClassDelete">
                <button type="button" style="float:right" class="btn btn-light bg-transparent" @onclick="async () => { await DeleteWord(); }">
                    <img width="20" height="20" src="/icons/trash-alt-solid.svg" asp-append-version="true" />
                </button>
            </div>
        </div>
    </div>
    <div class=@(CollapsedLike? "collapse" : "")>
        @if (likedUsers != null)
        {
            @foreach (var foudUser in likedUsers)
            {
                <Friendship UserId="@CurrentUserId" friendId="@foudUser.Key" friendName="@foudUser.Value.Item1" friendshipState="NotImportant"></Friendship>
            }
        }
    </div>

    <div class="card m-0 border-left-0 border-right-0 @(CollapsedComm? "collapse" : "")">
        <CascadingValue Value="@CurrentUserId">
            <div class="card-body p-0">

                @foreach (var comment in wordComments)
                {
                    <Comment commentModel="@comment" WordId="@wordModel.WordId" CurrentUserName="@CurrentUserName" WordUserId="@wordModel.UserId" OnCommentDelete="RemoveCommentHandlerAsync"></Comment>
                }

                <button type="button" class="btn btn-link bg-transparent" @onclick="@CreateComment">
                    <span>Add Comment </span> <img style="margin-left:5px;" width="20" height="20" src="/icons/comment-medical-solid.svg" asp-append-version="true" />
                </button>
            </div>
        </CascadingValue>
    </div>
</div>