@page "/Words"
@page "/Words/{UserId}"
@inject ILanguageContainerService languageContainer
@inherits WordsBase


<h4>@PageHeader</h4>

@if (Words != null && Words.Count > 0)
{
    @foreach (var word in Words)
    {
        word.UserName = null;
        <Word WordDto="word" Collapsed="true" OnWordDelete="DeleteWordHandler"></Word>
    }
}
@if (loading)
{
    <button type="button" class="btn btn-light">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </button>
}
else
{
    <button class="btn btn-outline-secondary bg-white text-dark m-2" type="button" @onclick="GetNextPage">
        Load more Words
    </button>
}