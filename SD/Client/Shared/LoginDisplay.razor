@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject ILanguageContainerService languageContainer
@inject SD.Client.Services.CurrentUserService     CurrUsrService


@inject NavigationManager Navigation
@inject SignOutSessionStateManager SignOutManager

<AuthorizeView>
    <Authorized>
        @languageContainer.Keys["Hello"], @context.User.Identity.Name!
        <button class="nav-link btn btn-link" @onclick="BeginLogout">@languageContainer.Keys["LogOut"]</button>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login">@languageContainer.Keys["LogIn"]</a>
    </NotAuthorized>
</AuthorizeView>

@code{

    private async Task BeginLogout(MouseEventArgs args)
    {
        await SignOutManager.SetSignOutState();
        Navigation.NavigateTo("authentication/logout");
    }


    protected override async Task OnInitializedAsync()
    {
        if (!CurrUsrService.isAuthTested) await CurrUsrService.GetAuth();
    }
}
