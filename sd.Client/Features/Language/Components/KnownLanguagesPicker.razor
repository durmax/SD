@using Microsoft.FluentUI.AspNetCore.Components
@using sd.Client.Models

<FluentGridItem xs="12">
    <FluentAutocomplete TOption="LangCode"
                        Label="@Label"
                        AutoComplete="off"
                        Width="@Width"
                        Placeholder="@Placeholder"
                        OnOptionsSearch="@OnOptionsSearch"
                        OptionText="@(item => item.Value)"
                        SelectedOptions="@SelectedOptionsSafe"
                        SelectedOptionsChanged="@SelectedOptionsChanged" />
</FluentGridItem>

@code {
    // Text / style
    [Parameter] public string Label { get; set; } = "Add language";
    [Parameter] public string Placeholder { get; set; } = "Add language";
    [Parameter] public string Width { get; set; } = "100%";

    // Data binding
    [Parameter] public IEnumerable<LangCode>? SelectedOptions { get; set; }
    [Parameter] public EventCallback<IEnumerable<LangCode>> SelectedOptionsChanged { get; set; }

    // Search callback from page
    [Parameter] public EventCallback<OptionsSearchEventArgs<LangCode>> OnOptionsSearch { get; set; }

    private IEnumerable<LangCode> SelectedOptionsSafe => SelectedOptions ?? Array.Empty<LangCode>();
}
