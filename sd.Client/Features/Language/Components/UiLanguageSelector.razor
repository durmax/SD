@using Microsoft.FluentUI.AspNetCore.Components
@using sd.Client.Features.Language.Contracts

<FluentGridItem xs="12">
    <FluentCombobox TOption="LanguageOption"
                    Items="@ItemsSafe"
                    Width="35%"
                    Label="@Label"
                    OptionText="@(i => i.Name)"
                    OptionValue="@(i => i.Code)"
                    SelectedOption="@SelectedOption"
                    SelectedOptionChanged="OnSelectedOptionChanged"
                    Autocomplete="ComboboxAutocomplete.Inline" />
</FluentGridItem>

@code {
    [Parameter] public IEnumerable<LanguageOption>? Items { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Label { get; set; } = "UI Language";
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private IEnumerable<LanguageOption> ItemsSafe => Items ?? Array.Empty<LanguageOption>();

    private LanguageOption SelectedOption =>
        ItemsSafe.FirstOrDefault(x => x.Code == Value);

    private async Task OnSelectedOptionChanged(LanguageOption option)
    {
        if (string.IsNullOrWhiteSpace(option.Code))
            return;

        Value = option.Code;

        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(Value);
    }
}