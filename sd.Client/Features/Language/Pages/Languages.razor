@page "/Languages"
@inherits LanguagesBase
@using sd.Client.Features.Language.Components
@using sd.Client.Helpers
@using sd.Client.Models
@using sd.Client.Features.Language.Contracts
@using sd.Client.Pages
@using sd.Client.Services

<FluentCard Class="lang-card">
    <!-- Header -->
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="4" Class="lang-header">
        <h5>Languages</h5>
        <p>Choose your UI language, select your learning languages, and manage translation resources.</p>
    </FluentStack>

    <!-- Main content -->
    <FluentGrid Class="lang-grid">
        <FluentGridItem xs="12" sm="12" md="12" lg="12">
            <FluentCard AreaRestricted="false">

                <h6>Languages</h6>
                <KnownLanguagesPicker Label="@LanguageContainer.Keys["AddLang"]"
                                      Placeholder="@LanguageContainer.Keys["AddLang"]"
                                      Width="100%"
                                      OnOptionsSearch="OnSearchAsync"
                                      SelectedOptions="SelectedItems"
                                      SelectedOptionsChanged="OnSelectedOptionsChanged" />

            </FluentCard>
        </FluentGridItem>

        <!-- Section: Display -->
        <FluentGridItem xs="12" sm="12" md="12" lg="12">
            <FluentCard AreaRestricted="false">
                <h6>Display</h6>
                <UiLanguageSelector Items="UiLangItems"
                                    Value="@UILang"
                                    ValueChanged="OnUILangChanged"
                                    Label="UI Language" />

            </FluentCard>
        </FluentGridItem>

        <!-- Section: Pair -->
        <FluentGridItem xs="12" sm="12" md="12" lg="12">
            <FluentCard AreaRestricted="false">
                <h6>Language pair</h6>

                <!-- Optional: show current pair as a chip/badge -->
                <FluentBadge Appearance="Appearance.Neutral">
                    @ActivePair.From.Code → @ActivePair.To.Code
                </FluentBadge>

                <DefaultLanguagesSelector Items="SelectedItems"
                                          Pair="ActivePair"
                                          PairChanged="OnActivePairChanged"
                                          Reverse="Reverse"
                                          FirstLanguageLabel="@LanguageContainer.Keys["Firstlanguage"]"
                                          SecondLanguageLabel="@LanguageContainer.Keys["Secondlanguage"]" />

            </FluentCard>
        </FluentGridItem>

        <!-- Section: Resources -->
        <FluentGridItem xs="12" sm="12" md="12" lg="12">
            <FluentCard AreaRestricted="false">

                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
                    <FluentStack Orientation="Orientation.Vertical" HorizontalGap="2">
                        <h6>Resources</h6>
                        <p>Drag the handle to reorder. Click the star to set a favorite.</p>
                    </FluentStack>
                    <!-- Add a compact action like "Add resource" later -->
                    <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size24.Add())">Add</FluentButton>
                </FluentStack>

                @if (opRes is null || opRes.Count == 0)
                {
                    <FluentCard Class="empty-state">
                        <FluentStack Orientation="Orientation.Vertical" HorizontalGap="6" HorizontalAlignment="HorizontalAlignment.Center">
                            <h6>No resources yet</h6>
                            <p>Add languages and configure resources for this pair.</p>
                        </FluentStack>
                    </FluentCard>
                }
                else
                {
                    <FluentSortableList Items="opRes" OnUpdate="@SortListAsync" Sort="true" Handle="true" Class="resource-list">
                        <ItemTemplate>
                            <FluentStack Orientation="Orientation.Horizontal"
                                         HorizontalGap="10"
                                         VerticalAlignment="VerticalAlignment.Center"
                                         Class="resource-row">
                                <!-- Bigger grab handle -->
                                <FluentButton Appearance="Appearance.Accent"
                                              Class="grab-btn sortable-grab"
                                              Title="Drag to reorder">
                                    <span aria-hidden="true">≡</span>
                                </FluentButton>
                                <div class="resource-content">
                                    <OtherPage op="@context"
                                               FavSite="@FavSite"
                                               OnFavoriteChanged="@SetFavSiteAsync"
                                               CanSetFavSite="true"
                                               FLangCode="@ActivePair.From.Code"
                                               TLangCode="@ActivePair.To.Code" />
                                </div>
                            </FluentStack>
                        </ItemTemplate>
                    </FluentSortableList>
                }

            </FluentCard>
        </FluentGridItem>

        <!-- Danger zone -->
        <FluentGridItem xs="12" sm="12" md="12" lg="12">
            <FluentCard>
                <FluentStack Orientation="Orientation.Vertical" HorizontalGap="8">
                    <h6>Reset</h6>
                    <p>These actions affect stored data and cannot be undone.</p>

                    <FluentStack Orientation="Orientation.Horizontal" VerticalGap="2">
                        <p>Clears all saved settings, resources, and favorites.</p>
                        <FluentButton Appearance="Appearance.Accent"
                                      Style="margin-left: auto;"
                                      BackgroundColor="Red"
                                      OnClick="() => isRemoveAllDialogHidden = false">
                            Remove
                        </FluentButton>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" VerticalGap="2">
                        <p>Only for active pair: @ActivePair.From.Code → @ActivePair.To.Code</p>
                        <FluentButton Appearance="Appearance.Outline"
                                      Style="margin-left: auto;"
                                      OnClick="() => isResetDialogHidden = false">
                            Reset resources
                        </FluentButton>
                    </FluentStack>

                </FluentStack>

            </FluentCard>
        </FluentGridItem>
    </FluentGrid>

</FluentCard>


<!-- Confirm dialogs -->
<ConfirmDialog @bind-Hidden="isResetDialogHidden"
               Title="Reset resources for this pair?"
               ConfirmText="Reset"
               OnConfirm="ResetOPAsync">
    <Body>
        This will reset the resource order and settings for
        <b>@ActivePair.From.Code → @ActivePair.To.Code</b>.
    </Body>
</ConfirmDialog>

<ConfirmDialog @bind-Hidden="isRemoveAllDialogHidden"
               Title="Remove all stored data?"
               ConfirmText="Remove"
               ConfirmBackgroundColor="Red"
               OnConfirm="RemoveAllDataAsync">
    <Body>
        This action cannot be undone.
    </Body>
</ConfirmDialog>
