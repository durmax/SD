@page "/Languages"
@inherits LanguagesBase
@using sd.Client.Features.Language.Components
@using sd.Client.Models
@using sd.Client.Services

<div class="card">
    <div class="card-header"><b>@LanguageContainer.Keys["LangConfig"]</b></div>

    <FluentGrid Spacing="1" AdaptiveRendering="true" Justify="JustifyContent.Center" Style="padding: 2px;">
        <FluentGridItem xs="12">
            <FluentAutocomplete TOption="LangCode"
                                Label="@LanguageContainer.Keys["AddLang"]"
                                dir="rtl"
                                AutoComplete="off"
                                Width="100%"
                                Placeholder="@LanguageContainer.Keys["AddLang"]"
                                OnOptionsSearch="@OnSearchAsync"
                                OptionText="@(item => item.Value)"
                                SelectedOptions="@SelectedItems"
                                SelectedOptionsChanged="@OnSelectedOptionsChanged" />

        </FluentGridItem>

         @if (SelectedItems != null && SelectedTL != null)
        {
            <!-- UI language: use the UILangs list (not SelectedItems) -->
             <FluentGridItem xs="12">
                <FluentCombobox TOption="LangCode"
                                Items="@UiLangItems"
                                Width="35%"
                                Label="UI Language"
                                OptionText="@(i => i.Value)"
                                OptionValue="@(i => i.Key)"
                                Value="@UILang"
                                ValueChanged="OnUILangChanged"
                                Autocomplete="ComboboxAutocomplete.Inline" />
            </FluentGridItem>
            <DefaultLanguagesSelector Items="SelectedItems"
                                      Tl="@Tl"
                                      Fl="@Fl"
                                      TlChanged="OnMotherlanguageKeyChanged"
                                      FlChanged="OnSecondlanguageKeyChanged"
                                      MotherLanguageLabel="@LanguageContainer.Keys["Motherlanguage"]"
                                      SecondLanguageLabel="@LanguageContainer.Keys["Secondlanguage"]" />
        } 
    </FluentGrid>

    @if (KnownLangs != null)
    {
        <div class="card mt-2 mb-2">
            <div class="input-group">
                <select class="bg-transparent rounded-0 border-0" @bind="Fl">
                    @foreach (var item in KnownLangs)
                    {
                        <option value="@item">@item</option>
                    }
                </select>

                <button type="button" class="btn btn-light bg-transparent" @onclick="Reverse">
                    <i class="oi oi-loop"></i>
                </button>

                <select class="bg-transparent rounded-0 border-0" @bind="Tl">
                    @foreach (var item in KnownLangs)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>

            @if (opRes != null)
            {
                <FluentSortableList Items="opRes" OnUpdate="@SortListAsync" Sort="true" Handle="true">
                    <ItemTemplate>
                        <span class="sortable-grab" title="Drag to reorder">≡</span>
                        <div class="sortable-item-content">
                            <OtherPage otherPage="@context"
                                       FavSite="@FavSite"
                                       CanSetFavSite="true"
                                       FLangCode="@Fl"
                                       TLangCode="@Tl" />
                        </div>
                    </ItemTemplate>
                </FluentSortableList>
            }
        </div>

        <div class="mb-2">
            <button type="reset" class="btn btn-light" @onclick="ResetOPAsync"> Reset for @Fl-@Tl </button>
            <button type="reset" class="btn btn-danger float-right" @onclick="RemoveAllDataAsync">Remove all stored data</button>
        </div>
    }
</div>
