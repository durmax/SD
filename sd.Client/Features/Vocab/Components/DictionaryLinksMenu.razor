@using Microsoft.Extensions.Logging
@using sd.Client.Helpers
@using sd.Client.Services
@using sd.Shared

<FluentButton Id="@WordDto.WordId"
              Appearance="Appearance.Outline"
              IconStart="@(new Icons.Regular.Size16.MoreHorizontal())"
              OnClick="@(() => open = !open)" />

<FluentMenu Anchor="@WordDto.WordId" UseMenuService="true" @bind-Open="open">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
        @if (dictProviders != null)
        {
            @foreach (var dp in dictProviders)
            {
                <FluentMenuItem OnClick="@(() => OpenLink(dp.Link))">
                    <FluentStack Orientation="Orientation.Horizontal"
                                 HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                                 VerticalAlignment="VerticalAlignment.Center"
                                 Style="width:100%">

                        <span>@dp.Host</span>

                        @if (dp.IsFavorite)
                        {
                            <FluentIcon Icon="Icons.Color.Size16.Star" />
                        }
                    </FluentStack>
                </FluentMenuItem>
            }
        }
    </FluentStack>
</FluentMenu>


@code {

    [Inject] DictionaryLinksService DictionaryLinksService { set; get; }
    [Inject] LocalStorageAccessor LocalStorageAccessor { get; set; }
    [Inject] IJSRuntime JsRuntime { set; get; }
    [Inject] ILogger<WordBase> Log { get; set; }

    [Parameter] public WordDto WordDto { get; set; }

    protected bool open = false;
    protected List<DictionaryProviderDto> dictProviders { get; set; } = new();


    protected async Task OpenLink(string url)
    {
        open = false;                    // close menu deterministically
        await JsRuntime.InvokeVoidAsync("open", url, "_blank"); // window.open
    }

    protected override async Task OnParametersSetAsync()
    {
        dictProviders = await DictionaryLinksService.GetDictionaryProviders(WordDto?.WordLang, WordDto?.ToLang, WordDto?.Title);
        //    await LoadHtmlExplain();
    }
}
