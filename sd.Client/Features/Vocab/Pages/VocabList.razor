@page "/"
@inherits VocabListBase
@using sd.Client.Features.Vocab.Components;


<FluentIcon OnClick="@Store.AddNewDraftRow" Value="@(new Icons.Regular.Size24.FormNew())" />

@if (Store.Items != null)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
        @foreach (var word in Store.Items)
        {
            <Word WordDto="word"
                  OnWordSave="@OnWordSave"
                  OnWordFound="@OnWordFound"
                  OnWordDelete="@OnWordDelete" />
        }
    </FluentStack>

}

@if (Store.IsLoading)
{
    <button type="button" class="btn btn-light">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </button>
}
else
{
    <button class="btn btn-outline-secondary bg-white text-dark m-2" type="button" @onclick="LoadMore">
        Load more Words
    </button>
}
