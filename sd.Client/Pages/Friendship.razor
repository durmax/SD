@inherits FriendshipBase

<div class="row">
    <div class="col-8">
        <a type="button" class="btn btn-link"
           href="Words/@FriendId">@FriendName</a>
    </div>
    <div class="col-4">

        @{
            switch (Relationship)
            {
                //case "NotImportant":

                //    break;

                case sd.Shared.Relation.Friend:

                    <button type="button" class="btn btn-link"
                            @onclick="@(async () => { await RemoveFriend(FriendId); })">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" />
                    </button>
                    break;

                case sd.Shared.Relation.FriendRequestTo:

                    <div class="btn btn-link">
                        <FluentIcon Value="@(new Icons.Regular.Size16.SendPerson())" />
                    </div>
                    break;

                case sd.Shared.Relation.FriendRequestFrom:

                    <div class="input-group">
                        <div class="input-group-prepend">
                            <button type="button" class="btn btn-link"
                                    @onclick="@(async () => { await AddFriend(); })">
                                <FluentIcon Value="@(new Icons.Regular.Size16.PersonAdd())" />
                            </button>

                            <button type="button" class="btn btn-link"
                                    @onclick="@(async () => { await RemoveFriendRequest(); })">
                                <FluentIcon Value="@(new Icons.Regular.Size16.PersonDelete())" />
                            </button>
                        </div>
                    </div>
                    break;

                default:

                    <button type="button" class="btn btn-link"
                            @onclick="@(async () => { await SendFriendRequest(FriendId); })">
                        <FluentIcon Value="@(new Icons.Regular.Size16.PersonAdd())" />
                    </button>
                    break;
            }
        }
    </div>
</div>