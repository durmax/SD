@page "/"
@inherits IndexBase

@if (FriendRequestsDictionary.Count > 0)
{
    <button type="button" class="btn btn-primary mb-2" @onclick="() => CollapsedFriend = CollapsedFriend ? false : true">
        Friend Requests <span class="badge badge-light">@FriendRequestsDictionary.Count</span>
        <span class="sr-only">Friend Requests</span>
    </button>

    <div class="card @(CollapsedFriend ? "collapse" : "")">
        <div class="card-body">
            <div class="container">
                @foreach (var item in FriendRequestsDictionary)
                {
                    <Friendship FriendId="@item.Key" FriendName="@item.Value"></Friendship>
                }

            </div>
        </div>
    </div>
}

<FluentIcon OnClick="@AddNewWord" Value="@(new Icons.Regular.Size24.FormNew())" />

@if (WordDtosState.Model != null)
{
    @foreach (var word in WordDtosState.Model)
    {
        <Word WordDto="word" Collapsed="Guid.TryParse(word?.WordId, out Guid result)" OnWordSave="@NewWordHandler" OnWordFound="@OldWordHandler" OnWordDelete="DeleteWordHandler"></Word>
    }
}

@if (loading)
{
    <button type="button" class="btn btn-light">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </button>
}
else
{
    <button class="btn btn-outline-secondary bg-white text-dark m-2" type="button" @onclick="GetNextPage">
        Load more Words
    </button>
}