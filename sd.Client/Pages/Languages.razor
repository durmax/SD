@page "/Languages"
@inherits LanguagesBase
@using Blazored.Typeahead
@using sd.Client.Models
@using sd.Client.Services

@inject sd.Client.Services.LocalStorageAccessor LocalStorageAccessor;


<div class="card">
    <div class="card-header"><b>@LanguageContainer.Keys["LangConfig"]</b></div>

    <FluentGrid Spacing="1" AdaptiveRendering="true" Justify=JustifyContent.Center Style="padding: 2px; ">
        <FluentGridItem xs="12">
            <FluentAutocomplete TOption="LangCode"
                                Label="@LanguageContainer.Keys["AddLang"]"
                                dir="rtl"
                                AutoComplete="off"
                                Width="100%"
                                Placeholder="@LanguageContainer.Keys["AddLang"]"
                                OnOptionsSearch="@OnSearchAsync"
                                OptionText="@(item => item.Value)"
                                @bind-SelectedOptions="@SelectedItems" />
        </FluentGridItem>


        @if (SelectedItems != null && SelectedTL != null)
        {
            <FluentGridItem xs="12">
                <FluentCombobox TOption="LangCode" Items=@SelectedItems
                                Width="35%"
                                Label="UI Language"
                                OptionText="@(i => i.Value)"
                                OptionValue="@(i => i.Key)"
                                @bind-Value=@UILang
                                Autocomplete="ComboboxAutocomplete.Inline"
                                SelectedOptionChanged="SetUILang" />
            </FluentGridItem>
            <FluentGridItem xs="6">
                <FluentCombobox TOption="LangCode" Items=@SelectedItems
                                Width="70%"
                                Label="@LanguageContainer.Keys["Motherlanguage"]"
                                OptionText="@(i => i.Value)"
                                OptionValue="@(i => i.Key)"
                                Value="@SelectedTL.Value"
                                Autocomplete="ComboboxAutocomplete.Inline"
                                SelectedOptionChanged=" OnMotherlanguageChanged" />
            </FluentGridItem>
            <FluentGridItem xs="6">
                <FluentCombobox TOption="LangCode" Items=@SelectedItems
                                Width="70%"
                                Label="@LanguageContainer.Keys["Secondlanguage"]"
                                OptionText="@(i => i.Value)"
                                OptionValue="@(i => i.Key)"
                                Value="@SelectedFL.Value"
                                Autocomplete="ComboboxAutocomplete.Inline"
                                SelectedOptionChanged=" OnSecondlanguageChanged" />
            </FluentGridItem>
        }
    </FluentGrid>

    @if (KnownLangs != null)
    {
        <div class="card mt-2 mb-2">
            <div class="input-group">
                <select class="bg-transparent rounded-0 border-0" @bind="Fl">
                    @foreach (var item in KnownLangs)
                    {
                        if (item == SelectedFL?.Key)
                        {
                            <option selected value="@SelectedFL?.Key">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
                <button type="button" class="btn btn-light bg-transparent" @onclick="Reverse">
                    <i class="oi oi-loop"></i>
                </button>
                <select class="bg-transparent rounded-0 border-0" @bind="Tl">
                    @foreach (var item in KnownLangs)
                    {
                        if (item == SelectedTL?.Key)
                        {
                            <option selected value="@SelectedTL?.Key">@item</option>
                        }
                        else
                        {
                            <option value="@item">@item</option>
                        }
                    }
                </select>
            </div>

            <OtherPages Sortable="@true" FLangCode="@Fl" TLangCode="@Tl" Collapsed="false" CanSetFavSite="true"></OtherPages>
        </div>

        @*     <AuthorizeView>
    <Authorized> *@
        <div class="mb-2">
            <button type="reset" class="btn btn-light" @onclick="ResetOPAsync"> Reset for @Fl-@Tl </button>
            <button type="reset" class="btn btn-danger float-right" @onclick="RemoveAllDataAsync">Remove all stored data</button>
        </div>
        @*         </Authorized>
    </AuthorizeView> *@
    }
</div>