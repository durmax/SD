@page "/OtherPageManager/{id}"
@page "/OtherPageManager/Host/{host}"
@using System.Security.Claims
@using sd.Client.Helpers
@inherits OtherPageManagerBase

<h3>OtherPage</h3>

<AuthorizeView Context="auth">
    <Authorized>
        1. Enter Example URL to get the pattern automatically (Test the result before saving):
        <div class="form-group row">
            <div class="col-sm-12">
                <InputText id="ExampleURL" class="form-control" placeholder="ExampleURL" @bind-Value="@ExampleURL" />
            </div>
        </div>
        <div class="form-group row">
            <div class="col-sm-12">
                <button class="btn btn-outline-primary" @onclick="GetModelByAi"><i class="fa fa-save"></i>Try get data</button>
            </div>
        </div>

        2. Or enter the data manually:
        <EditForm Model="@otherPageModel" OnValidSubmit="SaveData" Context="op">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-group row">
                <div class="col-sm-10">
                    <InputText id="Name" class="form-control" placeholder="Host"
                               @bind-Value="otherPageModel.Host" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-10">
                    <InputText id="email" class="form-control" placeholder="PageType"
                               @bind-Value="otherPageModel.PageType" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-10">
                    <InputNumber id="email" class="form-control" placeholder="Eval"
                                 @bind-Value="otherPageModel.Eval" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-12">
                    <InputText id="Name" class="form-control" placeholder="Pattern"
                               @bind-Value="otherPageModel.Pattern" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-10">
                    <div class="input-group mb-3">
                        <select class="custom-select" id="PrimLangs" @bind="TempPrimLang">
                            <option selected value="All">All</option>
                            @foreach (var lang in LangCodesHelper.Langs)
                            {
                                <option value="@lang.Key">@lang.Value</option>
                            }
                        </select>
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary" type="button" @onclick="(() => AddPrimLang(TempPrimLang))">Add PrimLang</button>
                        </div>
                    </div>

                    @if (PrimLangs != null)
                    {
                        <div class="input-group mb-3" style="width:auto;">
                            <ul class="form-check form-check-inline">
                                @foreach (var item in PrimLangs)
                                {
                                    <li @key="item"
                                        class="btn btn-outline-secondary form-check-inline">
                                        <label class="form-check-label">
                                            @item
                                        </label>
                                        <button type="button" class="btn btn-link"
                                                @onclick="(() => RemovePrimLang(item))">
                                            (&#9747;)
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group row">
                <div class="col-sm-10">
                    <div class="input-group mb-3">
                        <select class="custom-select" id="PrimLangs" @bind="TempSecLang">
                            <option selected value="All">All</option>
                            @foreach (var lang in LangCodesHelper.Langs)
                            {
                                <option value="@lang.Key">@lang.Value</option>
                            }
                        </select>
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary" type="button" @onclick="(() => AddSecLang(TempSecLang))">Add SecLang</button>
                        </div>
                    </div>

                    @if (SecLangs != null)
                    {
                        <div class="input-group mb-3" style="width:auto;">
                            <ul class="form-check form-check-inline">
                                @foreach (var item in SecLangs)
                                {
                                    <li @key="item"
                                        class="btn btn-outline-secondary form-check-inline">
                                        <label class="form-check-label">
                                            @item
                                        </label>
                                        <button type="button" class="btn btn-link"
                                                @onclick="(() => RemoveSecLang(item))">
                                            (&#9747;)
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

            @if (otherPageModel.Notes != null)
            {
                <p>Notes for this page:</p>
                <div>
                    <ul>
                        @foreach (var item in otherPageModel.Notes)
                        {
                            <li>
                                @item
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="form-group row">
                <div class="col-sm-10">
                    <div class="alert alert-primary @InfoShowClass" role="alert">
                        @Info
                    </div>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-10">
                    <p>ID: @otherPageModel.OtherPageId</p>
                </div>
            </div>
            <div class="form-group row">
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-outline-primary"><i class="fa fa-save"></i> Save</button>
                </div>
            </div>
        </EditForm>
        <div class="col-sm-10">
            <button class="btn btn-outline-danger" @onclick="RemoveOtherPage"><i class="fa fa-trash-o fa-lg"></i> Remove</button>
        </div>
    </Authorized>
</AuthorizeView>


