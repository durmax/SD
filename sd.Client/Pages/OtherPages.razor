@inherits OtherPagesBase
@inject ILanguageContainerService languageContainer

@if (!Collapsed && opRes == null)
{
    <div class="d-flex justify-content-center p-1">
        <div class="spinner-border" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="card m-0 border-left-0 border-right-0 overflow-auto" style="max-height:@MaxHeight">

        <div class="@(Collapsed ? "collapse" : "")">

            @if (opRes != null)
            {
                <FluentSortableList Items="opRes" OnUpdate="@SortListAsync" Sort="@Sortable" Handle="true">
                    <ItemTemplate>
                        @* Show handle only when sortable *@
                        @if (Sortable)
                        {
                            <span class="sortable-grab" title="Drag to reorder">≡</span>
                        }
                        <div class="sortable-item-content">
                        <OtherPage otherPage=@context FavSite="@FavSite" CanSetFavSite="@CanSetFavSite" FLangCode="@FLangCode" TLangCode="@TLangCode" />
                        </div>
                    </ItemTemplate>
                </FluentSortableList>
            }
        </div>
    </div>
}
