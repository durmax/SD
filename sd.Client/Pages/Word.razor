@page "/Word/{WordId}"
@inject ILanguageContainerService languageContainer
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

@inherits WordBase


@if (!string.IsNullOrWhiteSpace(note))
{
    @note
}

@if (WordDto != null)
{
    <div class="card mt-1 position-relative @(!Guid.TryParse(WordDto?.WordId, out Guid result) ? "border-primary" : "border-dark")">
        @if (!string.IsNullOrEmpty(WordDto.UserName))
        {
            <div class="card-header p-0">
                <a class="text-decoration-none pl-1" href="Words/@WordDto.UserId">@WordDto.UserName</a>
            </div>
        }

        <FluentTextField Id="wordId"
                         Value="@WordDto.Title"
                         InputMode="InputMode.Search"
                         style="width: 100%;"
                         @ref="wordTitleRef"
                         @onkeydown="KeydownAsync"
                         @oninput="@(async (ui) => await WordChangedAsync(ui.Value?.ToString() ?? ""))">

            <FluentButton slot="end"
                          Appearance="Appearance.Stealth"
                          @onclick="OnCollapsed"
                          IconEnd="@(new Icons.Regular.Size16.ArrowExpand())">
            </FluentButton>
        </FluentTextField>


        @if (!Collapsed)
        {
            <div class="btn-toolbar" role="toolbar" aria-label="Toolbar with button groups">

                @{
                    var list = new List<string> { languageContainer.Keys["OnlyMe"], languageContainer.Keys["Friends"], languageContainer.Keys["Public"] };
                }

                <Dropdown TItem="int" OnSelected="@OnSelectedAsync">
                    <InitialTip>
                        @switch (WordDto.ShareWith)
                        {
                            case sd.Shared.ShareWith.OnlyMe:
                                <FluentIcon Value="@(new Icons.Regular.Size16.GlobeOff())" />
                                break;
                            case sd.Shared.ShareWith.Friends:
                                <FluentIcon Value="@(new Icons.Regular.Size16.ShareScreenPersonOverlay())" />
                                break;
                            case sd.Shared.ShareWith.Public:
                                <FluentIcon Value="@(new Icons.Regular.Size16.Globe())" />
                                break;
                        }
                    </InitialTip>

                    <ChildContent>
                        <div class="d-block p-2">
                            <DropdownListItem Item="0">
                                <FluentIcon Value="@(new Icons.Regular.Size16.GlobeOff())" /> @list[0]
                            </DropdownListItem>
                        </div>
                        <div class="d-block p-2">
                            <DropdownListItem Item="1">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ShareScreenPersonOverlay())" /> @list[1]
                            </DropdownListItem>
                        </div>
                        <div class="d-block p-2">
                            <DropdownListItem Item="2">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Globe())" /> @list[2]
                            </DropdownListItem>
                        </div>
                    </ChildContent>
                </Dropdown>

                <button type="button" class="bg-transparent border-0" @onclick="async () => { await AddWord(); }">
                    <FluentIcon Value="@(new Icons.Regular.Size16.CloudAdd())" />
                </button>
                <button type="button" class="@cssClassDelete bg-transparent border-0 pl-3 pr-3" @onclick="async () => { await DeleteWord(); }">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" />
                </button>
                <button type="button" class="bg-transparent border-0 pl-3 pr-3" @onclick="async () => { await GetAi(); }">
                    <FluentIcon Value="@(new Icons.Regular.Size16.FlashSparkle())" />
                </button>

                <SpeakButton Explain="@Explain" IsSpeakingChanged="OnSpeakingChanged" />

                <input class="position-absolute text-center border-0 mt-1 w-25" style="right:20px" @bind="@WordDto.Score" />
            </div>
            @if (loading)
            {
                <button type="button" class="btn btn-light bg-transparent">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </button>
            }

            <div style="max-width:500px">
                @if (SameWords != null && !string.IsNullOrWhiteSpace(WordDto.Title))
                {
                    @foreach (var w in SameWords)
                    {
                        <a href="" class="m-1" @onclick="async () => { await SetWord(w.Split(':')[1]); }">
                            <u class="text-primary"> @w.Split(':')[0] </u>
                        </a>
                    }
                }

                @if (LanguageToolWords != null && !string.IsNullOrWhiteSpace(WordDto.Title))
                {
                    @foreach (var w in LanguageToolWords)
                    {
                        <a @onclick="() => WordDto.Title = w">@w</a>
                    }
                }
            </div>

            <div class="card-body p-0">

                <div class="card mb-1 @cssClassUpdate">
                    <div class="card-body">
                        <div class="text-muted">@WordDto.Title is already exist</div>
                    </div>
                    <div class="card-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="UpdateWord">
                            Update <i class="fas fa-question-circle"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="@(() => { foundWordDtoToUpdate = null; cssClassUpdate = "d-none"; })">
                            Cancel <i class="fas fa-window-close"></i>
                        </button>
                    </div>
                </div>
                <div class="m-0">

                    <BlazoredTextEditor @ref="@QuillHtml" Placeholder="Write your note here!">
                        <ToolbarContent>
                            <select class="ql-header">
                                <option selected=""></option>
                                <option value="1"></option>
                                <option value="2"></option>
                                <option value="3"></option>
                                <option value="4"></option>
                                <option value="5"></option>
                            </select>
                            @* <span class="ql-formats"> *@
                            <select class="ql-color"></select>
                            <select class="ql-background"></select>
                            @* </span> *@
                            @* <span class="ql-formats"> *@
                            <button class="ql-bold"></button>
                            <button class="ql-italic"></button>
                            <button class="ql-underline"></button>
                            <button class="ql-strike"></button>
                            @* </span> *@
                            @* <span class="ql-formats"> *@
                            <button class="ql-list" value="ordered"></button>
                            <button class="ql-list" value="bullet"></button>
                            @* </span> *@
                            @* <span class="ql-formats"> *@
                            <button class="ql-link"></button>
                            @* </span> *@
                        </ToolbarContent>
                        <EditorContent></EditorContent>
                    </BlazoredTextEditor>
                </div>

                @if (KnownLangs != null)
                {
                    bool IsEqual(string str1, string str2) => str1 == str2;

                    <div class="pl-3">
                        <select class="bg-transparent rounded-0 border-0" @bind="@WordDto.WordLang">
                            @foreach (var item in KnownLangs)
                            {
                                <option value="@item" selected="@IsEqual(item, WordDto.WordLang)">@item</option>
                            }
                        </select>

                        <button type="button" class="bg-transparent border-0" @onclick="Reverse">
                            <i class="oi oi-loop"></i>
                        </button>

                        <select class="bg-transparent rounded-0 border-0" @bind="@WordDto.ToLang">
                            @foreach (var item in KnownLangs)
                            {
                                <option value="@item" selected="@IsEqual(item, WordDto.ToLang)">@item</option>
                            }
                        </select>
                    </div>
                }



                @if (opRes != null && !(string.IsNullOrWhiteSpace(WordDto.WordLang) || string.IsNullOrWhiteSpace(WordDto.ToLang)))
                {
                    <div class="card m-0 border-left-0 border-right-0 overflow-auto" style="max-height:200px">
                    @foreach (var op in opRes)
                    {
                        <OtherPage otherPage="@op" FavSite="@FavSite" CanSetFavSite="@false" FLangCode="@WordDto.WordLang" TLangCode="@WordDto.ToLang" />
                    }
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(WordDto.WordId))
            {
                <div class="card-footer p-0">
                    <div class="row  fs-6">
                        <div class="col-3">
                            <button type="button" style="float:left" class="btn btn-light bg-transparent" @onclick="async () => { await LikeAsync(); }">
                                @if (CULiked)
                                {
                                    <FluentIcon Value="@(new Icons.Filled.Size24.ThumbLike())" />
                                }
                                else
                                {
                                    <FluentIcon Value="@(new Icons.Regular.Size16.ThumbLike())" />
                                }
                            </button>
                            @if (LikesCount != null && (CULiked ? LikesCount > 1 : LikesCount > 0))
                            {
                                <button type="button" class="btn btn-light bg-transparent" @onclick="async () => { await GetLikedUsers(LikesCount); }">
                                    @LikesCount <i>likes</i>
                                </button>
                            }
                        </div>
                        <div class="col-3">
                            <div type="button" style="float:right" class="col-2 btn btn-light bg-transparent" @onclick="OnCollapsed">
                                @if (!Collapsed)
                                {
                                    <i class="oi oi-collapse-up"></i>
                                }
                            </div>
                        </div>

                        <div class="col-3">
                            <button type="button" style="float:right" class="btn btn-light bg-transparent" @onclick="GetWordCommentsAsync">
                                @if (WordDto.CommentsCount > 0)
                                {
                                    @WordDto.CommentsCount
                                }

                                <FluentIcon Value="@(new Icons.Regular.Size16.Comment())" />
                            </button>
                        </div>

                        <div class="col-3">
                            <a type="button" class="btn btn-link" target="_blank"
                               href="Word/@WordDto.WordId">Share</a>
                        </div>
                    </div>
                </div>

                <div class=@(CollapsedLike ? "collapse" : "")>
                    @if (likedUsers != null)
                    {
                        @foreach (var foudUser in likedUsers)
                        {
                            <Friendship FriendId="@foudUser.UserId" FriendName="@foudUser.RelationalUserName" Relationship="foudUser.Relation"></Friendship>
                        }
                    }
                </div>

                <div class="card m-0 border-left-0 border-right-0 @(CollapsedComm ? "collapse" : "")">
                    @if (!CollapsedComm)
                    {
                        <div class="card-body p-0">

                            @foreach (var comment in WordComments)
                            {
                                <Comment CommentModel="@comment" WordId="@WordDto.WordId" WordUserId="@WordDto.UserId" OnCommentDelete="RemoveCommentHandlerAsync"></Comment>
                            }

                            <button type="button" class="btn btn-link bg-transparent" @onclick="@CreateComment">
                                <span>Add Comment </span>
                                <FluentIcon Value="@(new Icons.Regular.Size16.CommentAdd())" />
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </div>
}