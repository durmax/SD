	<ItemGroup>
		<PackageReference Include="AKSoftware.Localization.MultiLanguages" Version="6.0.1" />
		<PackageReference Include="Blazored.Typeahead" Version="4.7.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" />
		<PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.2" />
