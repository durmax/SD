		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.13.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="System.Net.Http.Json" Version="10.0.2" />
		<PackageReference Include="Blazored.TextEditor" Version="1.1.3" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\sd.Shared\sd.Shared.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Features\Vocab\Mapping\" />
	  <Folder Include="SharedUI\" />
	</ItemGroup>
</Project>
